{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ipa-sources-admin",
  "workers_dev": true,
  "routes": [
    { "pattern": "ipa-sources-admin.whoops.space", "custom_domain": true }
  ],
  "main": "apps-admin/src/index.js",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "assets": {
    "directory": "./apps-admin/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GITHUB_OWNER": "zhanghuid",
    "GITHUB_REPO": "ipa.sources",
    "GITHUB_BRANCH": "main",
    "GITHUB_FILE_PATH": "config/sources/custom/ipas.json",
    "ACCESS_ISSUER": "https://ttys.cloudflareaccess.com",
    "ACCESS_AUD": "e746918f2137ae4f6ce35d022c1af4032472b51220fb7579e8641f4354e73d0e"
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
