{
  "name": "ipa-sources",
  "version": "0.1.2",
  "private": true,
  "description": "Personal AltSource-compatible IPA catalog",
  "scripts": {
    "release": "bumpp --commit --tag --push",
    "generate": "python3 scripts/generate_ios.py && python3 scripts/generate_android.py",
    "test": "python3 -m unittest discover -s tests",
    "admin:dev": "wrangler dev --config wrangler.production.jsonc",
    "admin:deploy": "wrangler deploy --config wrangler.production.jsonc"
  },
  "devDependencies": {
    "bumpp": "^12.3.0",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "jose": "^6.2.12"
  }
}
